{
  "name": "arc-raiders-wiki",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run data:validate && npm run assets:ensure && vite build && npm run prerender",
    "preview": "vite preview --host 127.0.0.1",
    "data:maps": "node scripts/refresh-map-snapshot.mjs",
    "data:blueprints": "node scripts/build-blueprint-routes.mjs",
    "data:audit": "node scripts/build-research-audit.mjs",
    "data:arc-links": "node scripts/build-arc-map-index.mjs",
    "lint": "eslint src tests *.config.*",
    "format": "prettier --write src tests *.config.* package.json .github/workflows/*.yml",
    "data:validate": "vitest run tests/data-validation.test.ts",
    "prerender": "node scripts/build-prerender.mjs",
    "assets:ensure": "node scripts/ensure-image-assets.mjs",
    "predev": "npm run assets:ensure"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "leaflet": "1.9.4",
    "motion": "^14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "2.6.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
